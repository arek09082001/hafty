# Adresse und oeffentlicher Schluessel des Supabase-Projekts.
# Beides steht in der Supabase-Oberflaeche unter Project Settings -> API.
#
# Die App hat keine Anmeldung. Wer diese beiden Werte hat, kommt an die
# Muster heran - sie stehen im Quelltext der ausgelieferten Seite. Der
# Schutz besteht allein darin, die Adresse der App nicht herumzureichen.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fuer das Einlesen der Garnfarben - sowohl fuer das Skript
# (npm run garne-importieren) als auch fuer den Knopf "Garnfarben einlesen"
# in der App. Der Knopf laeuft ueber eine Server-Route, also muss dieser
# Schluessel beim Hoster gesetzt sein, damit er dort funktioniert.
#
# Er gehoert niemals in den Browser: keine Variable mit NEXT_PUBLIC_ davor.
# Wer ihn hat, kommt an Rechten und RLS vorbei an die ganze Datenbank.
SUPABASE_SERVICE_ROLE_KEY=
