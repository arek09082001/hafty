# Adresse und oeffentlicher Schluessel des Supabase-Projekts.
# Beides steht in der Supabase-Oberflaeche unter Project Settings -> API.
#
# Die App hat keine Anmeldung. Wer diese beiden Werte hat, kommt an die
# Muster heran - sie stehen im Quelltext der ausgelieferten Seite. Der
# Schutz besteht allein darin, die Adresse der App nicht herumzureichen.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur fuer das Importskript der Garnfarben (npm run garne-importieren).
# Dieser Schluessel gehoert niemals in den Browser und nicht zum Hoster.
SUPABASE_SERVICE_ROLE_KEY=
